<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The 26100 SDK projection gives the WinRT media, Bluetooth, radio and
         notification APIs. MinVersion keeps it running on anything 22H2+. -->
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22621.0</SupportedOSPlatformVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
    <RootNamespace>Isola</RootNamespace>
    <AssemblyName>Isola</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets\island.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>

    <!-- Everything is written to be NativeAOT-safe (LibraryImport, generated
         COM, source-generated JSON). Self-contained either way, so no runtime
         that Windows Update installs or removes can break it. -->
    <SelfContained>true</SelfContained>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <IsAotCompatible>true</IsAotCompatible>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <!-- Auto: also generate marshalling for collections the code passes into
         WinRT (e.g. the Bluetooth watcher's property list); "true" alone does not. -->
    <CsWinRTAotOptimizerEnabled>Auto</CsWinRTAotOptimizerEnabled>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CA1416;SYSLIB1054;CS8981;CA2101;IL2050</NoWarn>
  </PropertyGroup>

  <!-- `dotnet publish -p:Aot=true` once MSVC's linker is present. -->
  <PropertyGroup Condition="'$(Aot)' == 'true'">
    <PublishAot>true</PublishAot>
    <OptimizationPreference>Size</OptimizationPreference>
    <StackTraceSupport>true</StackTraceSupport>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Aot)' != 'true'">
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src\**\*.cs" />
    <None Include="assets\**" CopyToOutputDirectory="PreserveNewest" />
    <InternalsVisibleTo Include="Isola.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Vortice.Direct2D1" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DirectComposition" Version="3.8.3" />
  </ItemGroup>

</Project>
