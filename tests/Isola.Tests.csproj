<Project Sdk="Microsoft.NET.Sdk">

  <!-- Compiles the island's real source (everything but its Main) and drives it
       against fakes. Run: dotnet run -c Release (see tests/README.md). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22621.0</SupportedOSPlatformVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Isola.Tests</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <InvariantGlobalization>true</InvariantGlobalization>
    <CsWinRTAotOptimizerEnabled>Auto</CsWinRTAotOptimizerEnabled>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <NoWarn>$(NoWarn);CA1416;SYSLIB1054;CS8981;CA2101;IL2050;CS0169;CS0414;CS0649</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\src\**\*.cs" Exclude="..\src\App\Program.cs" LinkBase="src" />
    <Compile Include="*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Vortice.Direct2D1" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DirectComposition" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- the installer's move from a Dynamic Island install, tested as shipped -->
    <Compile Include="..\installer\Legacy.cs" Link="Legacy.cs" />
  </ItemGroup>
</Project>
